# Appwrite — required for auth and database
# Get these from: https://cloud.appwrite.io → your project → Settings

# Your Appwrite API endpoint
VITE_APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"

# Found in: Project Settings → Project ID
VITE_APPWRITE_PROJECT_ID="your-project-id-here"

# Found in: Databases → your database → Database ID
VITE_APPWRITE_DATABASE_ID="your-database-id-here"

# Found in: Databases → your database → your collection → Collection ID
VITE_APPWRITE_COLLECTION_ID="profiles"

# Direct download URL (GitHub Releases recommended for large files)
# Format: https://github.com/USER/REPO/releases/download/TAG/FILENAME.exe
VITE_DOWNLOAD_URL="https://github.com/OPcheats/friday-ai-releases/releases/download/v1.2.6/FRIDAY-AI-1.2.6-Setup.exe"
